# Copy to .env.local (git-ignored). Never commit real keys.

# --- Public (shipped to the browser, inlined at build time) ---
# Supabase API as the BROWSER sees it. Local dev: `cd backend && npx supabase status`.
# Behind the deploy/ Caddy proxy (single origin) use the site origin, e.g. http://localhost:8080.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Devnet RPC used by the wallet adapter and server-side verification.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Wallet that RECEIVES SOL payments (public address only; its secret key is never needed here).
NEXT_PUBLIC_PAYMENT_RECIPIENT=8SK4YoGYoTgxnpLpevFC5YakBJc2zAZPj8NbQSEv9N9n
# Absolute site origin used in NFT metadata URIs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase URL for server-side calls when it differs from the browser URL
# (in Docker: http://supabase_kong_ronriku:8000). Defaults to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_INTERNAL_URL=
# Mint authority: JSON array of 64 secret-key bytes. Co-signs prepared purchase transactions and is
# the Core update authority. Needs NO SOL (buyers pay fees + rent). `pnpm --filter web create-mint-authority`.
MINT_AUTHORITY_SECRET_KEY=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP (rate-limit keys).
TRUSTED_PROXY=
