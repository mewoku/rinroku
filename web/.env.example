# Copy to .env.local (git-ignored). Never commit real keys.

# --- Public (shipped to the browser) ---
# Local Supabase: `cd backend && npx supabase status` prints the API URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Devnet RPC used by the wallet adapter and server-side verification.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Treasury public key (base58). scripts/create-treasury.ts writes it.
NEXT_PUBLIC_TREASURY_PUBKEY=
# Absolute site origin used in NFT metadata URIs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# JSON array of 64 secret-key bytes. Created by `pnpm --filter web create-treasury`.
TREASURY_SECRET_KEY=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For / X-Real-IP (rate-limit keys).
TRUSTED_PROXY=
