# deploy/.env — read by docker compose (git-ignored). deploy/up.sh creates and fills it.
# Never commit the real file: it holds the service-role key and the mint authority secret.

# --- Public site ---
# ":80" = plain HTTP on any host (local). A hostname (play.example.com) = automatic HTTPS; its DNS
# A/AAAA record must point at this server and ports 80 + 443 must be reachable.
DOMAIN=:80
# Browser-visible origin (NFT metadata URIs, Next metadataBase). Baked into the image at build.
SITE_URL=http://localhost:8080
# Host ports for Caddy. Local: 127.0.0.1:8080. VPS: BIND_ADDR=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Supabase (from `cd backend && npx supabase status -o env`) ---
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Docker network + Kong container of the Supabase CLI stack (project id "ronriku").
SUPABASE_NETWORK=supabase_network_ronriku
SUPABASE_UPSTREAM=supabase_kong_ronriku:8000
SUPABASE_INTERNAL_URL=http://supabase_kong_ronriku:8000

# --- Solana (devnet) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# Wallet that receives SOL payments (public address).
PAYMENT_RECIPIENT=8SK4YoGYoTgxnpLpevFC5YakBJc2zAZPj8NbQSEv9N9n
# Server mint authority: JSON array of 64 bytes. Needs no SOL. Empty = SOL purchases disabled.
MINT_AUTHORITY_SECRET_KEY=

# Unity WebGL build directory (mounted read-only; build it with RONRIKU → Build WebGL (Website)).
UNITY_BUILD_DIR=../web/public/unity
WEB_MEM_LIMIT=768m
