# deploy/.env — read by docker compose (git-ignored). deploy/up.sh creates and fills it.
# Never commit the real file: it holds the service-role key and the mint authority secret.

# --- Public site ---
# A hostname = automatic HTTPS (Let's Encrypt); its DNS A/AAAA record must point at this server and
# ports 80 + 443 must be reachable. ":80" = plain HTTP on any host (`up.sh --local` writes that).
DOMAIN=odlet.xyz
# Browser-visible origin (NFT metadata URIs, Next metadataBase). Baked into the image at build.
# up.sh sets it to https://$DOMAIN (server) or http://localhost:8080 (--local).
SITE_URL=https://odlet.xyz
# Public support/privacy contact shown on /privacy and /terms (app stores require one).
# PLACEHOLDER: the owner must create this mailbox before launch.
CONTACT_EMAIL=hello@odlet.xyz
# Domain shown in the wallet-link sign message. Informational here: the wallet-link edge function
# reads WALLET_LINK_DOMAIN from its own env (backend/supabase/config.toml [edge_runtime.secrets]);
# its built-in default is already odlet.xyz.
WALLET_LINK_DOMAIN=odlet.xyz
# Host ports for Caddy. Local: 127.0.0.1:8080. VPS: BIND_ADDR=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443.
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Supabase (from `cd backend && npx supabase status -o env`) ---
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Docker network + Kong container of the Supabase CLI stack (project id "ronriku").
SUPABASE_NETWORK=supabase_network_ronriku
SUPABASE_UPSTREAM=supabase_kong_ronriku:8000
SUPABASE_INTERNAL_URL=http://supabase_kong_ronriku:8000

# --- Solana (devnet) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
# Wallet that receives SOL payments (public address).
PAYMENT_RECIPIENT=8SK4YoGYoTgxnpLpevFC5YakBJc2zAZPj8NbQSEv9N9n
# Server mint authority: JSON array of 64 bytes. Needs no SOL. Empty = SOL purchases disabled.
MINT_AUTHORITY_SECRET_KEY=

# Unity WebGL build directory (mounted read-only; build it with the Unity menu Build WebGL (Website)).
UNITY_BUILD_DIR=../web/public/unity
WEB_MEM_LIMIT=768m
